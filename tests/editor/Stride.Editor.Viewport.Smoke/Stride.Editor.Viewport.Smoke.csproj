<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <ProjectReference Include="../../../sources/editor/Stride.GameStudio.Avalonia/Stride.GameStudio.Avalonia.csproj" />
    <ProjectReference Include="../../../sources/editor/Stride.GameStudio.Avalonia.Desktop/Stride.GameStudio.Avalonia.Desktop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyEditorNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <EditorNativeRuntime Include="$(MSBuildProjectDirectory)/../../../sources/editor/Stride.GameStudio.Avalonia.Desktop/bin/$(Configuration)/$(TargetFramework)/runtimes/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorNativeRuntime)" DestinationFiles="@(EditorNativeRuntime->'$(OutDir)runtimes/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
