<Styles xmlns="https://github.com/avaloniaui"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dock provides the docking templates, commands, drag targets and floating
       windows; this file adapts their appearance to the Game Studio palette. -->
  <Styles.Resources>
    <x:Double x:Key="DockFontSizeNormal">12</x:Double>
    <x:Double x:Key="DockHeaderHeight">22</x:Double>
    <x:Double x:Key="DockTabHeight">22</x:Double>
    <x:Double x:Key="DockDocumentTabItemMinHeight">22</x:Double>
      <x:Double x:Key="TabItemHeaderFontSize">12</x:Double>
      <x:Double x:Key="TabItemMinHeight">22</x:Double>
      <Thickness x:Key="TabItemHeaderMargin">6,2</Thickness>
      <FontWeight x:Key="TabItemHeaderThemeFontWeight">Normal</FontWeight>
  </Styles.Resources>

  <Style Selector="DockPanel.studioPanel">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/>
  </Style>
  <Style Selector="UserControl.studioSurface">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/>
  </Style>
  <Style Selector="Border.studioPanelHeader">
    <Setter Property="Background" Value="{DynamicResource StudioHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="MinHeight" Value="22"/>
  </Style>
  <Style Selector="Border.studioPanelHeader Button.studioPanelHeaderButton">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="MinHeight" Value="16"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="UserControl.editorShell TabControl">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="UserControl.editorShell TabItem">
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="UserControl.editorShell TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="TabControl.studioDockTabs TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabControl.studioDocumentTabs TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/>
  </Style>
  <Style Selector="UserControl.editorShell TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioHeaderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/>
  </Style>
  <Style Selector="UserControl.editorShell TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource StudioHeaderBrush}"/>
  </Style>
  <Style Selector="TabControl.studioDocumentTabs TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="TabControl.studioDocumentTabs TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource StudioSelectionBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="dock|DockControl">
    <Setter Property="Background" Value="{DynamicResource StudioBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/>
  </Style>
  <Style Selector="dock|ToolControl, dock|DocumentControl">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}"/>
  </Style>
  <Style Selector="dock|ToolChromeControl">
    <Setter Property="Background" Value="{DynamicResource StudioHeaderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}"/>
  </Style>
</Styles>
