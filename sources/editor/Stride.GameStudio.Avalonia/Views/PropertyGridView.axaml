<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:caeb="using:Stride.Core.Assets.Editor.Avalonia.Behaviors"
             xmlns:caecp="using:Stride.Core.Assets.Editor.Components.Properties"
             xmlns:caevm="using:Stride.Core.Assets.Editor.ViewModels"
             xmlns:cpc="using:Stride.Core.Presentation.Commands"
             xmlns:cpqvm="using:Stride.Core.Presentation.Quantum.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="Stride.GameStudio.Avalonia.Views.PropertyGridView"
             x:DataType="caecp:SessionObjectPropertiesViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Themes/PropertyViewTheme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="sd|PropertyViewItem[IsHovered=True]">
      <Setter Property="Background" Value="{DynamicResource PropertyHoveredBackground}"/>
    </Style>
    <Style Selector="sd|PropertyViewItem[IsFocused=True]">
      <Setter Property="Background" Value="{DynamicResource PropertyFocusedBackground}"/>
    </Style>
    <Style Selector="TextBox.propertyFilterBox.hasFilter">
      <Setter Property="BorderBrush" Value="SteelBlue"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto, Auto, Auto, *, 5, 70"
        Background="{DynamicResource StudioHeaderBrush}">
    <!-- Row 0: Navigation, selection description, and Add new tag -->
    <DockPanel Grid.Row="0" Margin="6,6,6,2" LastChildFill="True">
      <!-- Adding tag -->
      <TextBox x:Name="NewTagTextBox"
               DockPanel.Dock="Right"
               MinWidth="90"
               PlaceholderText="{sd:LocalizeString Add new tag}"
               IsVisible="{Binding Session.AssetCollection.SelectedAssets.Count, Converter={sd:NumericToBool}, FallbackValue={sd:False}}"
               KeyDown="NewTagTextBox_OnKeyDown"/>
      <!-- Navigation -->
      <StackPanel DockPanel.Dock="Left"
                  Orientation="Horizontal"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
        <Button Classes="studioTool"
                Command="{Binding Session.PreviousSelectionCommand, FallbackValue={x:Static cpc:DisabledCommand.Instance}}"
                HotKey="Alt+Left"
                ToolTip.Tip="{sd:LocalizeString Previous selection, Context=ToolTip}">
          <Image Source="{StaticResource ImagePrevious}" Width="16" Height="16"/>
        </Button>
        <Button Classes="studioTool"
                Command="{Binding Session.NextSelectionCommand, FallbackValue={x:Static cpc:DisabledCommand.Instance}}"
                HotKey="Alt+Right"
                ToolTip.Tip="{sd:LocalizeString Next selection, Context=ToolTip}">
          <Image Source="{StaticResource ImageNext}" Width="16" Height="16"/>
        </Button>
      </StackPanel>
      <!-- Description -->
      <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
        <Run Text="{Binding TypeDescription, Mode=OneWay}" FontWeight="Bold"/>
        <Run Text=" "/>
        <Run Text="{Binding Name, Mode=OneWay}"/>
      </TextBlock>
    </DockPanel>

    <!-- Row 1: Asset tags -->
    <ItemsControl Grid.Row="1"
                  Margin="6,2"
                  ItemsSource="{Binding Session.AssetTags.Tags}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding Session.AssetTags.Tags.Count, Converter={sd:NumericToBool}, FallbackValue={sd:False}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="caevm:TagsViewModel+TagViewModel">
          <sd:TagControl Height="20"
                         Margin="2"
                         ToolTip.Tip="{Binding Name}"
                         IsVisible="{Binding Assets.Count, Converter={sd:NumericToBool}}"
                         VerticalAlignment="Center"
                         CloseTagCommand="{Binding RemoveTagCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="2,0"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="100"
                         VerticalAlignment="Center"/>
              <Button Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Command="{Binding AddTagToAllCommand}"
                      IsEnabled="{Binding Counter, Converter={sd:Chained {sd:IsEqualToParam}, {sd:InvertBool}, Parameter1=' (all)'}}"
                      ToolTip.Tip="{sd:LocalizeString Add tag to all, Context=ToolTip}">
                <TextBlock Text="{Binding Counter}" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </sd:TagControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Row 2: Open in editor button & Search properties filter -->
    <DockPanel Grid.Row="2" Margin="6,2">
      <Button DockPanel.Dock="Top"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Margin="0,0,0,8"
              Command="{Binding Session.EditSelectedContentCommand, FallbackValue={x:Static cpc:DisabledCommand.Instance}}"
              IsVisible="{Binding Session.EditSelectedContentCommand.IsEnabled, FallbackValue={sd:False}}">
        <Grid>
          <DockPanel IsVisible="{Binding #AssetPropertyView.IsVisible}">
            <Image Source="{StaticResource ImageEditAsset}"
                   Margin="4"
                   DockPanel.Dock="Left"
                   Width="16" Height="16"/>
            <TextBlock Text="{sd:LocalizeString Open this asset in editor}"
                       Margin="0,4,4,4"
                       VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="{sd:LocalizeString Show this asset in editor}"
                     Margin="0,4,4,4"
                     VerticalAlignment="Center"
                     IsVisible="{Binding #AssetPropertyView.IsVisible, Converter={sd:InvertBool}}"/>
        </Grid>
      </Button>
      <DockPanel IsVisible="{Binding #AssetPropertyView.IsVisible}">
        <!-- Disabling this button for now, matching WPF GameStudioWindow.xaml -->
        <ToggleButton Margin="4,0"
                      Height="22" Width="22"
                      IsChecked="{Binding ShowOverridesOnly}"
                      ToolTip.Tip="{sd:LocalizeString Display only overridden properties, Context=ToolTip}"
                      IsVisible="False">
          <Image Source="{StaticResource ImageAssetOverride}" Width="16" Height="16"/>
        </ToggleButton>
        <TextBox x:Name="PropertyFilterTextBox"
                 Classes="propertyFilterBox"
                 Classes.hasFilter="{Binding $self.Text, Converter={sd:ObjectToBool}}"
                 PlaceholderText="{sd:LocalizeString Search properties}"/>
      </DockPanel>
    </DockPanel>

    <!-- Row 3: PropertyView & Fallback message -->
    <Border Grid.Row="3" Background="{DynamicResource StudioPanelBrush}">
      <Grid>
        <sd:PropertyView x:Name="AssetPropertyView"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         IsEnabled="{Binding CanDisplayProperties}"
                         IsVisible="{Binding ViewModel, Converter={sd:ObjectToBool}}">
          <Interaction.Behaviors>
            <caeb:PropertyViewAutoExpandNodesBehavior ViewModel="{Binding ViewModel, Mode=OneWay}" />
            <caeb:PropertyViewFilteringBehavior FilterToken="{Binding #PropertyFilterTextBox.Text, Mode=OneWay}" />
          </Interaction.Behaviors>
        </sd:PropertyView>
        <TextBlock Text="{Binding FallbackMessage}"
                   IsVisible="{Binding #AssetPropertyView.IsVisible, Converter={sd:InvertBool}}"
                   Foreground="{DynamicResource StudioMutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="16"/>
      </Grid>
    </Border>

    <!-- Row 4: Splitter -->
    <GridSplitter Grid.Row="4"
                  HorizontalAlignment="Stretch"
                  Height="5"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"/>

    <!-- Row 5: Hovered property documentation -->
    <Border Grid.Row="5"
            Background="{DynamicResource StudioHeaderBrush}">
      <DockPanel x:DataType="cpqvm:NodeViewModel"
                 DataContext="{Binding #AssetPropertyView.HoveredItem.DataContext}">
        <Grid Margin="4"
              DockPanel.Dock="Top"
              ColumnDefinitions="Auto, 20, *, Auto">
          <TextBlock Grid.Column="0"
                     FontWeight="Bold"
                     FontStyle="Normal"
                     Text="{Binding DisplayName, FallbackValue={x:Null}}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2"
                     FontWeight="Thin"
                     FontStyle="Italic"
                     TextAlignment="Right"
                     Text="{Binding Type, Converter={sd:TypeToNamespace}, ConverterParameter='$.', FallbackValue={x:Null}}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="3"
                     FontWeight="Bold"
                     FontStyle="Italic"
                     TextAlignment="Left"
                     Text="{Binding Type, Converter={sd:TypeToTypeName}, FallbackValue={x:Null}}"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
        <TextBlock Margin="4"
                   Text="{Binding [Documentation], FallbackValue={x:Null}}"
                   TextWrapping="Wrap"
                   TextTrimming="WordEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
