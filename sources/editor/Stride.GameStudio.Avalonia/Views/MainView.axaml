<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:caect="using:Stride.Core.Assets.Editor.Components.Transactions"
             xmlns:caevm="using:Stride.Core.Assets.Editor.ViewModels"
             xmlns:caec="using:Stride.Core.Assets.Editor.Avalonia.Converters"
             xmlns:capvm="using:Stride.Core.Assets.Presentation.ViewModels"
             xmlns:cpc="using:Stride.Core.Presentation.Commands"
             xmlns:gsc="using:Stride.GameStudio.Avalonia.Converters"
             xmlns:gsh="using:Stride.GameStudio.Avalonia.Helpers"
             xmlns:gsvm="using:Stride.GameStudio.Avalonia.ViewModels"
             xmlns:gsvw="using:Stride.GameStudio.Avalonia.Views"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:gscontrols="using:Stride.GameStudio.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Stride.GameStudio.Avalonia.Views.MainView"
             Classes="editorShell"
             x:DataType="gsvm:MainViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding Session.EditorCollection.CloseEditorCommand}" CommandParameter="{Binding Session.EditorCollection.ActiveEditor}"/>
  </UserControl.KeyBindings>
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <gsvm:MainViewModel/>
  </Design.DataContext>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="SessionExplorerTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <gsvw:SolutionExplorerView Classes="studioSurface"
                                     BorderThickness="1" BorderBrush="{DynamicResource StudioBorderBrush}"
                                     Padding="0" DataContext="{Binding Session}"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="PropertyGridTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <gsvw:PropertyGridView Classes="studioSurface" BorderThickness="1"
                                  BorderBrush="{DynamicResource StudioBorderBrush}" Padding="0"
                                  DataContext="{Binding Session?.ActiveProperties}"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="AssetViewTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <gsvw:AssetExplorerView BorderThickness="1"
                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                Padding="0"
                                DataContext="{Binding Session?.AssetCollection}"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="AssetLogTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <sd:TextLogViewer x:Name="AssetErrorsViewer" LogMessages="{Binding Session?.AssetLog.FilteredMessages}" CanClearLog="False"
                            ShowDebugMessages="False" ShowVerboseMessages="False" ShowInfoMessages="False"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="BuildLogTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <sd:TextLogViewer x:Name="OutputViewer" LogMessages="{Binding Session?.OutputLog.Messages}"
                            ShowDebugMessages="False" ShowVerboseMessages="False"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="AssetPreviewTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <gsvw:AssetPreviewView BorderThickness="1"
                               BorderBrush="{DynamicResource StudioBorderBrush}"
                               Padding="0"
                               DataContext="{Binding Session}"/>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="ActionHistoryTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <ListBox ItemsSource="{Binding Session?.ActionHistory?.Transactions}"
                   HorizontalAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="caect:TransactionViewModel">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" x:Name="Text"
                             Text="{Binding Name}"/>
                  <Image DockPanel.Dock="Right" x:Name="Image"
                         HorizontalAlignment="Right"
                         IsVisible="{Binding IsSavePoint, Mode=OneWay}"
                         Source="{StaticResource ImageSave}"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </UserControl>
      </DataTemplate>
      <DataTemplate x:Key="ReferencesTemplate" x:DataType="gsvm:MainViewModel">
        <UserControl Classes="editorShell">
          <DockPanel>
            <!-- Toolbar -->
            <DockPanel DockPanel.Dock="Top" Margin="4,2">
              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding !Session.References.ShowReferencers}" Content="{sd:LocalizeString References}" MinWidth="76"/>
              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding Session.References.ShowReferencers}" Content="{sd:LocalizeString Referenced by}" MinWidth="76"/>
              <Menu DockPanel.Dock="Right" Background="Transparent">
                <MenuItem Header="⋯" Padding="4,0" ToolTip.Tip="Reference display options">
                  <MenuItem Header="Sort by name" Command="{Binding Session.References.DisplayedReferences.SortAssetsCommand}" CommandParameter="{x:Static caevm:SortRule.Name}"/>
                  <MenuItem Header="Sort by type" Command="{Binding Session.References.DisplayedReferences.SortAssetsCommand}" CommandParameter="{x:Static caevm:SortRule.TypeOrderThenName}"/>
                  <MenuItem Header="Clear filters" Command="{Binding Session.References.DisplayedReferences.ClearAssetFiltersCommand}"/>
                </MenuItem>
              </Menu>
              <sd:SearchComboBox MinWidth="40" Margin="4,0" PlaceholderText="Add a filter..."
                                 ItemsSource="{Binding Session.References.DisplayedReferences.AvailableAssetFilters}"
                                 SearchText="{Binding Session.References.DisplayedReferences.AssetFilterPattern}"
                                 ClearTextAfterSelection="True" Command="{Binding Session.References.DisplayedReferences.AddAssetFilterCommand}">
                <sd:SearchComboBox.ItemTemplate>
                  <DataTemplate DataType="caevm:AssetFilterViewModel">
                    <TextBlock Text="{Binding Converter={caec:AssetFilterViewModelToFullDisplayName}}"/>
                  </DataTemplate>
                </sd:SearchComboBox.ItemTemplate>
              </sd:SearchComboBox>
            </DockPanel>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Session.References.DisplayedReferences.CurrentAssetFilters}"
                          IsVisible="{Binding Session.References.DisplayedReferences.CurrentAssetFilters.Count, Converter={sd:NumericToBool}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="caevm:AssetFilterViewModel">
                  <Button Command="{Binding RemoveFilterCommand}" CommandParameter="{Binding}" Margin="2" Padding="4,0" ToolTip.Tip="Remove this filter">
                    <TextBlock Text="{Binding DisplayName}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Asset references -->
            <Border DockPanel.Dock="Bottom"
                    Padding="8,4">
              <TextBlock Text="{Binding Session.References.TypeCountersAsText}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <ToolTip.Tip>
                  <TextBlock Text="{Binding Session.References.TypeCountersAsText}"
                             TextTrimming="None" TextWrapping="Wrap"/>
                </ToolTip.Tip>
              </TextBlock>
            </Border>
            <ListBox Classes="studioAssetList" ItemsSource="{Binding Session.References.DisplayedReferences.FilteredAssets}"
                     SelectedItems="{Binding Session.References.DisplayedReferences.SelectedContent}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <gscontrols:AssetTilePanel ThumbnailSize="68"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type capvm:AssetViewModel}">
                  <gsvw:AssetCard ThumbnailSize="68">
                    <Interaction.Behaviors>
                      <EventTriggerBehavior EventName="DoubleTapped">
                        <InvokeCommandAction Command="{Binding ((caevm:SessionViewModel)Session).AssetCollection.SelectAssetCommand}"
                                             CommandParameter="{Binding}"/>
                      </EventTriggerBehavior>
                    </Interaction.Behaviors>
                  </gsvw:AssetCard>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </DockPanel>
        </UserControl>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto, Auto, *, 20"
        Background="{DynamicResource StudioBackgroundBrush}">
    <!-- Menus -->
    <Menu Grid.Row="0" Grid.Column="0"
          VerticalAlignment="Top">
      <!-- File menu -->
      <MenuItem Header="{sd:LocalizeString _File, Context=Menu}">
        <MenuItem Header="{sd:LocalizeString _Open..., Context=Menu}"
                  Command="{Binding OpenCommand}"
                  HotKey="Ctrl+O" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <MenuItem x:Name="SaveMenuItem" Header="{sd:LocalizeString _Save, Context=Menu}"
                  Command="{Binding SaveCommand}" HotKey="Ctrl+S" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <MenuItem Header="{sd:LocalizeString _Close, Context=Menu}"
                  Command="{Binding CloseCommand}"
                  IsEnabled="{Binding Session, Mode=OneWay, Converter={sd:ObjectToBool}}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString E_xit, Context=Menu}"
                  Command="{Binding ExitCommand}"
                  HotKey="Alt+F4" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
      </MenuItem>
      <!-- Edit menu -->
      <MenuItem Header="{sd:LocalizeString Edit, Context=Menu}">
        <MenuItem Header="{sd:LocalizeString Undo, Context=Menu}"
                  Command="{Binding Session?.ActionHistory?.UndoCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"
                  HotKey="Ctrl+Z" InputGesture="Ctrl+Z"/>
        <MenuItem Header="{sd:LocalizeString Redo, Context=Menu}"
                  Command="{Binding Session?.ActionHistory?.RedoCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"
                  HotKey="Ctrl+Y" InputGesture="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString _Settings..., Context=Menu}"
                  Command="{Binding OpenSettingsWindowCommand}"
                  IsEnabled="{Binding Session, Mode=OneWay, Converter={sd:ObjectToBool}}"/>
      </MenuItem>
      <MenuItem Header="{sd:LocalizeString _Project, Context=Menu}">
        <MenuItem x:Name="BuildProjectMenuItem" Header="Build project"
                  Command="{Binding ProjectBuild?.BuildProjectCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"
                  HotKey="F6" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <MenuItem x:Name="RunProjectMenuItem" Header="Run project"
                  Command="{Binding ProjectBuild?.RunProjectCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"
                  HotKey="F5" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <MenuItem x:Name="ReloadAssembliesMenuItem" Header="Reload assemblies"
                  Command="{Binding Session?.HotReload?.ReloadCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"/>
        <MenuItem Header="Automatically reload assemblies" ToggleType="CheckBox"
                  IsChecked="{Binding Session.HotReload.AutoReload, Mode=TwoWay}" IsEnabled="{Binding Session, Converter={sd:ObjectToBool}}"/>
        <MenuItem x:Name="CancelBuildMenuItem" Header="Cancel build"
                  Command="{Binding ProjectBuild?.CancelBuildCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"
                  HotKey="Ctrl+F6" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <Separator/>
        <MenuItem x:Name="UpdatePlatformsMenuItem" Header="Update platforms..."
                  Command="{Binding UpdatePlatformsCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}"/>
      </MenuItem>
      <MenuItem Header="{sd:LocalizeString _View, Context=Menu}">
        <MenuItem Header="Solution explorer" Click="TogglePanel_OnClick" CommandParameter="SessionExplorer">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.SessionExplorerPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Asset view" Click="TogglePanel_OnClick" CommandParameter="AssetView">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.AssetViewPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="References" Click="TogglePanel_OnClick" CommandParameter="References">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.ReferencesPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Asset preview" Click="TogglePanel_OnClick" CommandParameter="AssetPreview">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.AssetPreviewPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Property grid" Click="TogglePanel_OnClick" CommandParameter="PropertyGrid">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.PropertyGridPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Edit history" Click="TogglePanel_OnClick" CommandParameter="ActionHistory">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.ActionHistoryPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Asset errors" Click="TogglePanel_OnClick" CommandParameter="AssetLog">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.AssetLogPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Output" Click="TogglePanel_OnClick" CommandParameter="BuildLog">
          <MenuItem.Icon>
            <TextBlock Text="&#x2713;" IsVisible="{Binding Panels.BuildLogPanelVisible}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem x:Name="ResetLayoutMenuItem" Header="{sd:LocalizeString Reset layout, Context=Menu}" Click="ResetLayout_OnClick"/>
      </MenuItem>
      <!-- Help menu -->
      <MenuItem Header="{sd:LocalizeString _Help, Context=Menu}">
        <MenuItem Header="{sd:LocalizeString Online documentation, Context=Menu}"
            Command="{Binding OpenWebPageCommand}"
            CommandParameter="{x:Static gsh:StrideGameStudio.DocumentationUrl}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString Questions and answers, Context=Menu}"
                  Command="{Binding OpenWebPageCommand}"
                  CommandParameter="{x:Static gsh:StrideGameStudio.AnswersUrl}"/>
        <MenuItem Header="{sd:LocalizeString Report an issue..., Context=Menu}"
                  Command="{Binding OpenWebPageCommand}"
                  CommandParameter="{x:Static gsh:StrideGameStudio.ReportIssueUrl}"/>
        <MenuItem Header="{sd:LocalizeString Discord forum, Context=Menu}"
                  Command="{Binding OpenWebPageCommand}"
                  CommandParameter="{x:Static gsh:StrideGameStudio.ForumsUrl}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString Show debug window, Context=Menu}"
                  Command="{Binding OpenDebugWindowCommand}"
                  HotKey="Ctrl+Shift+D" InputGesture="{Binding $self.HotKey, Mode=OneTime}"/>
        <Separator/>
        <MenuItem Header="{sd:LocalizeString _About..., Context=Menu}"
                  Command="{Binding AboutCommand}"/>
      </MenuItem>
      <MenuItem Header="Debug"
                IsVisible="{sd:IsDebug}">
        <MenuItem Header="Simulate a crash"
                  Command="{Binding CrashCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Compact command strip, matching Game Studio's desktop layout. -->
    <Border Grid.Row="1" Classes="studioToolbar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="studioTool" Command="{Binding OpenCommand}" ToolTip.Tip="Open project (Ctrl+O)">
          <Image Source="{StaticResource ImageOpen}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="SaveButton" Classes="studioTool" Command="{Binding SaveCommand}" ToolTip.Tip="Save solution (Ctrl+S)">
          <Image Source="{StaticResource ImageSave}" Width="16" Height="16"/>
        </Button>
        <Separator Classes="studioToolSeparator"/>
        <Button Classes="studioTool" ToolTip.Tip="Undo (Ctrl+Z)"
                Command="{Binding Session?.ActionHistory.UndoCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}">
          <Image Source="{StaticResource ImageUndo}" Width="16" Height="16"/>
        </Button>
        <Button Classes="studioTool" ToolTip.Tip="Redo (Ctrl+Y)"
                Command="{Binding Session?.ActionHistory.RedoCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}">
          <Image Source="{StaticResource ImageRedo}" Width="16" Height="16"/>
        </Button>
        <Separator Classes="studioToolSeparator"/>
        <ComboBox x:Name="BuildProjectSelector" Width="180" MinHeight="24" Padding="4,0"
                  ItemsSource="{Binding Session?.Projects}"
                  SelectedItem="{Binding Session.CurrentProject, Mode=TwoWay}"
                  IsEnabled="{Binding ProjectBuild?.CanSelectProject, TargetNullValue={sd:False}}"
                  ToolTip.Tip="Project to build or run">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="capvm:ProjectViewModel">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectPath}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="BuildProjectButton" Classes="studioTool" ToolTip.Tip="Build project (F6, Ctrl+Shift+B)"
                Command="{Binding ProjectBuild?.BuildProjectCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}">
          <Image Source="{StaticResource ImageBuildProject}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="RunProjectButton" Classes="studioTool" ToolTip.Tip="Run project (F5)"
                Command="{Binding ProjectBuild?.RunProjectCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}">
          <Image Source="{StaticResource ImageStartProject}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="CancelBuildButton" Classes="studioTool" ToolTip.Tip="Cancel build (Ctrl+F6, Shift+F5)"
                Command="{Binding ProjectBuild?.CancelBuildCommand, TargetNullValue={x:Static cpc:DisabledCommand.Instance}}">
          <Image Source="{StaticResource ImageStopBuild}" Width="16" Height="16"/>
        </Button>
      </StackPanel>
    </Border>

    <dock:DockControl Grid.Row="2" x:Name="WorkspaceDock"/>

    <!-- Status bar -->
    <Grid Grid.Row="3"
          Background="{DynamicResource StudioStatusBrush}"
          IsVisible="{Binding Session, Converter={sd:ObjectToBool}}"
          ColumnDefinitions="2*, Auto, *, Auto, *, 100">
      <TextBlock Grid.Column="0"
                 Margin="8,0"
                 VerticalAlignment="Center"
                 Text="{Binding Status.CurrentStatus}"/>
      <Border Grid.Column="1"
              Margin="2"
              BorderThickness="1"
              BorderBrush="{DynamicResource StudioBorderBrush}"/>
      <TextBlock Grid.Column="2"
                 Margin="8,0"
                 VerticalAlignment="Center">
        <Run Text="{Binding Session?.AssetCollection.FilteredContent.Count, Mode=OneWay, Converter={sd:Localize Text={}{0} item, Plural={}{0} items, IsStringFormat=True, Context=StatusBar}}"/>
        <Run Text="{Binding Session?.AssetCollection.SelectedContent.Count, Mode=OneWay, Converter={sd:Localize Text=({0} selected), Plural=({0} selected), IsStringFormat=True, Context=StatusBar}}"/>
      </TextBlock>
      <Border Grid.Column="3"
              Margin="2"
              BorderThickness="1"
              BorderBrush="{DynamicResource StudioBorderBrush}"/>
      <TextBlock x:Name="BackgroundJobMessage" Grid.Column="4"
                 Margin="8,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{Binding Status.CurrentJob?.Message}"/>
      <ProgressBar x:Name="BackgroundJobProgress" Grid.Column="5"
                   IsVisible="{Binding Status.CurrentJob, Converter={sd:ObjectToBool}}"
                   Margin="0,2"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   IsIndeterminate="{Binding Status.CurrentJob?.IsIndeterminate, TargetNullValue={sd:True}}"
                   Maximum="{Binding Status.CurrentJob?.Total, TargetNullValue={sd:Double 0}}"
                   Value="{Binding Status.CurrentJob?.Current, TargetNullValue={sd:Double 0}}"/>
    </Grid>
  </Grid>
</UserControl>
