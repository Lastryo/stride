<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Stride.Core.Assets.Presentation.ViewModels"
             xmlns:vm2="using:Stride.Core.Assets.Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stride.GameStudio.Avalonia.Views.SolutionExplorerView"
             x:DataType="vm2:SessionViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="studioPanelHeader">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <Button Width="16" Height="16" MinWidth="16" MinHeight="16"
                  Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Panel options">
            <Image Source="{StaticResource ImageDropDown}" Width="10" Height="10"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Expand all" Click="ExpandAll_OnClick"/>
                <MenuItem Header="Collapse all" Click="CollapseAll_OnClick"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

      </DockPanel>
    </Border>
    <TreeView x:Name="SolutionTreeView" Classes="studioSolutionTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding PackageCategories.Values}"
              SelectedItems="{Binding AssetCollection.SelectedLocations}"
              SelectionMode="Multiple"
              PointerPressed="OnTreeViewPointerPressed"
              Margin="0">
      <TreeView.ContextMenu>
        <ContextMenu Opened="OnSolutionContextMenuOpened">
          <MenuItem Header="Create folder" Command="{Binding NewDirectoryCommand}" CommandParameter="{Binding AssetCollection.SelectedLocations}"/>
          <Separator/>
          <MenuItem Header="Show in Explorer" Command="{Binding ExploreCommand}" CommandParameter="{Binding AssetCollection.SelectedLocations}"/>
        </ContextMenu>
      </TreeView.ContextMenu>
      <Control.DataTemplates>
        <TreeDataTemplate DataType="{x:Type vm:AssetMountPointViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Name}">
            <Image Source="{StaticResource ImageRootFolder}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ICategoryViewModel}"
                           ItemsSource="{Binding Content}">
          <Grid ColumnDefinitions="16,*,Auto">
            <Image Source="{StaticResource ImageDepsRoot}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:DirectoryViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Path}">
            <Image Source="{StaticResource ImageFolder}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ProjectViewModel}"
                          ItemsSource="{Binding Content}">
          <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding ProjectPath}">
            <Image Source="{StaticResource ImageProject}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:PackageViewModel}"
                          ItemsSource="{Binding Content}">
          <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding PackagePath}">
            <Image Source="{StaticResource ImagePackage}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <DataTemplate DataType="{x:Type vm:PackageReferenceViewModel}">
          <Grid ColumnDefinitions="16,*,Auto">
            <Image Source="{StaticResource ImagePackageReference}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
        <TreeDataTemplate DataType="{x:Type vm:ProjectCodeViewModel}"
                          ItemsSource="{Binding SubDirectories}">
          <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Name}">
            <Image Source="{StaticResource ImageRootFolder}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="dirtyMarker" Text="*" IsVisible="{Binding IsDirty}"/>
          </Grid>
        </TreeDataTemplate>
        <!-- Fallback -->
        <DataTemplate DataType="{x:Type vm:SessionObjectViewModel}">
          <Grid ColumnDefinitions="16,*,Auto">
            <Image Source="{StaticResource ImageFolder}" Width="16" Height="16"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
      </Control.DataTemplates>
    </TreeView>
  </DockPanel>
  <UserControl.Styles>
    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.dirtyMarker">
      <Setter Property="Foreground" Value="{DynamicResource StudioMutedBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="1,0,0,0"/>
    </Style>
  </UserControl.Styles>
</UserControl>
