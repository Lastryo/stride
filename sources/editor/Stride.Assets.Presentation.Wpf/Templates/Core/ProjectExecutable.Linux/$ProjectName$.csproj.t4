<#@ template inherits="ProjectTemplateTransformation" language="C#" #>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework><#= Properties.TargetFramework #></TargetFramework>
    <RuntimeIdentifier><#= Properties.RuntimeIdentifier #></RuntimeIdentifier>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <RootNamespace><#= Properties.Namespace #></RootNamespace>

    <OutputPath>..\Bin\<#= Properties.CurrentPlatform #>\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Force msbuild to check to rebuild this assembly instead of letting VS IDE guess -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\<#= Properties.PackageGameRelativePath #></StrideCurrentPackagePath>
    <StrideProjectType>Executable</StrideProjectType>
    <StridePlatform><#= Properties.CurrentPlatform #></StridePlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\<#= Properties.ProjectGameRelativePath #>" />
    <PackageReference Include="Stride.Core.Assets.CompilerApp" Version="<#= Stride.Assets.StrideConfig.GetLatestPackageDependency().Version #>" IncludeAssets="build;buildTransitive" />
  </ItemGroup>

</Project>
